        "script_path": "f_mv.py"
    },
    "pass_through": false,
    "dependencies": {
        "python_required": ["dazzle-preserve"],
        "python_optional": ["pywin32"]
    },
    "taxonomy": {
        "category": "file-tools",
        "tags": ["move", "safe", "metadata", "ctime", "mtime", "atime", "acl", "preserve", "clobber-protection"]
    },
    "lifecycle": {
        "status": "active"
    }
}
