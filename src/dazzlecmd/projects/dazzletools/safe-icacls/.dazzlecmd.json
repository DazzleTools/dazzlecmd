    "runtime": {
        "type": "python",
        "entry_point": "main",
        "script_path": "safe_icacls.py"
    },
    "pass_through": false,
    "taxonomy": {
        "category": "system-tools",
        "tags": ["windows", "icacls", "permissions", "acl", "ntfs", "junction", "reparse", "symlink", "takeown", "admin"]
    },
    "lifecycle": {
        "status": "active"
    }
}
