# Enhanced .gitignore for RepoKit Projects
# This template provides comprehensive exclusions for various languages and tools

#######################
# Common ignored files #
#######################
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.bak
*.swp
*~
*.*~

#######################
# Project Directories #
#######################

# RepoKit standard private directories
/private/
# Any nested private/ dir (a tool's own design-doc repo, generated scaffolds,
# etc.) -- private content never ships, regardless of depth. /private/ above is
# only root-anchored; this catches private/ folders anywhere in the tree.
**/private/
/convos/
/logs/
/credentials/
/secrets/
**/__private__*

# Local development files
local/
.local/
.dev/

#######################
# Python              #
#######################

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.env/
.venv/
env.bak/
venv.bak/
pythonenv*

# Testing / coverage
.tox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
htmlcov/

#######################
# IDEs and Editors    #
#######################

# Visual Studio Code -- track only the shared ROOT .vscode config; nested
# per-dir .vscode/ (auto-generated watcherExclude cruft) is ignored everywhere.
**/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
*.code-workspace
.history/

# JetBrains
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
out/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

#######################
# Security & Secrets  #
#######################

# Token and credential files
credentials.json
.secret
.env

# Project-specific directories
/log/
/logs/
/private/
/convos/

#######################
# Project Specific    #
#######################

# Build artifacts
.build/
bin/

# Local kit overrides
*.kit.local.json

# Dev mode local config (machine-specific dev paths)
mode_local.json

# Version backup files (from update-version.sh)
*_version.py.backup
*_version.py.tmp

# Revision tracking
/revisions/

# Test run artifacts
/test_runs/
/test-runs/

# RepoKit Private Content Protection (DO NOT REMOVE)
.env.private
**/private_*
# Exception: the private-init tool's own source is a tracked tool file, not private content
!/projects/dazzletools/private-init/private_init.py
CLAUDE.md
private/claude/
private/temp/
private/notes/
private/docs/

# Local-only kit/aggregator hookups (not shipped publicly).
# wtf-windows is wired in locally as the recursion proof (aggregator
# embedding aggregator); it returns to public tracking when wtf-windows
# reaches its public milestone.
/projects/wtf/
/kits/wtf.kit.json
