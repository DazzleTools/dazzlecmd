# #58 packaging: ship the moved tool tree (projects/ + kits/ + aggregator.json,
# now under src/dazzlecmd/) as package data so the PyPI wheel gives a working dz.
#
# THE PRIVACY GUARANTEE IS THE CLEAN CHECKOUT, NOT A MANIFEST RULE: release builds
# MUST come from a clean checkout / CI, where the untracked wtf aggregator and the
# per-tool private/ design-doc nested-repos are gitignored and thus simply absent.
# The release wheel test asserts no private/ or wtf content leaked. The rules below
# are best-effort defense-in-depth for accidental dev-tree builds.
graft src/dazzlecmd/templates
graft src/dazzlecmd/projects
graft src/dazzlecmd/kits
include src/dazzlecmd/aggregator.json

# Drop the local-only wtf recursion-proof aggregator and every per-tool private/
# design-doc tree. These rules are BEST-EFFORT for accidental dev-tree builds; they
# are NOT the privacy guarantee. The guarantee is twofold: (a) release builds come
# from a clean checkout / CI, where private/ and wtf are gitignored and simply
# absent, and (b) scripts/check_dist_no_leak.py, which the publish workflow runs
# after the build to FAIL the release if any private/ or wtf path reached the sdist
# or wheel (depth-proof -- it matches path components, not globs). A bare "*" in a
# recursive-exclude matches EVERY file and would wipe the graft above (the v0.10.11
# bug); keep patterns path-anchored, and note recursive-exclude globs do not cross
# directory levels, so nested private/ content needs the depth ladder below.
prune src/dazzlecmd/projects/wtf
exclude src/dazzlecmd/kits/wtf.kit.json
recursive-exclude src/dazzlecmd/projects private/* private/*/* private/*/*/* private/*/*/*/* private/*/*/*/*/* private/*/*/*/*/*/*

# Build cruft (also drops any private/ nested-repo .git marker).
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude .vscode/*
global-exclude .git/*
global-exclude *.code-workspace
